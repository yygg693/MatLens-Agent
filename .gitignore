# ---- MatLens 敏感与本地文件 ----
.env
.env.*
!.env.example
.matlens/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 运行产物 ----
logs/
*.log
.matlens-*
# 测试运行期临时目录（dedup / write-dedup 等）
matlens-dedup-*/
matlens-write-dedup-*/
vendor/
.bytecode-fingerprint
.pytest-cache/
.pytest_cache/

# 写权限探针（whatsapp bridge / unbroker pdd 会在安装树里创建）
.write_test

# ---- Node ----
node_modules/
.npm/
*.tsbuildinfo

# ---- 本地工作台数据（项目记忆 / 任务记录，不入库）----
.workbuddy/

# ---- 桌面端构建产物 ----
apps/desktop/dist/
apps/desktop/release/
# install-stamp.json（write-build-stamp.mjs 生成的安装标记，每次构建都会变）
apps/desktop/build/

# ---- 工作区临时数据 ----
.workbuddy/tmp/

# ---- 本地备份与一次性产物（2026-10-16）----
_backup*/
_archive/
_e2e_server*.log
_e2e_*.png
*.bak
